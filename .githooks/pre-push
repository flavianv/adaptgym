#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
while read -r local_ref local_oid remote_ref remote_oid; do
    case "$local_oid" in
        0000000000000000000000000000000000000000) continue ;;
    esac
    python3 scripts/check_public_content.py --history --ref "$local_oid"
    python3 scripts/check_repository_secrets.py --history --ref "$local_oid"
done

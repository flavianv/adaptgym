{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaptgym.persona.general.v1",
  "title": "General synthetic persona without product preferences",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "first_name",
    "last_name",
    "full_name",
    "age",
    "gender",
    "nationality",
    "profession",
    "education",
    "income",
    "family",
    "household",
    "hobbies",
    "life_circumstances"
  ],
  "properties": {
    "first_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "last_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 70
    },
    "full_name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 130
    },
    "age": {
      "type": "integer",
      "minimum": 16,
      "maximum": 80
    },
    "gender": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "nationality": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "profession": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "field"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "education": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "field_of_study",
        "status"
      ],
      "properties": {
        "level": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "field_of_study": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "status": {
          "enum": [
            "completed",
            "in_progress",
            "paused",
            "not_applicable"
          ]
        }
      }
    },
    "income": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "currency",
        "time_basis"
      ],
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "amount"
            }
          },
          "required": [
            "amount"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "minimum"
                ]
              },
              {
                "required": [
                  "maximum"
                ]
              },
              {
                "required": [
                  "level"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "kind": {
              "const": "range"
            }
          },
          "required": [
            "minimum",
            "maximum"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "amount"
                ]
              },
              {
                "required": [
                  "level"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "kind": {
              "const": "level"
            }
          },
          "required": [
            "level"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "amount"
                ]
              },
              {
                "required": [
                  "minimum"
                ]
              },
              {
                "required": [
                  "maximum"
                ]
              }
            ]
          }
        }
      ],
      "properties": {
        "kind": {
          "enum": [
            "amount",
            "range",
            "level"
          ]
        },
        "amount": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "minimum": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "maximum": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "level": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 80
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "time_basis": {
          "enum": [
            "hourly",
            "monthly",
            "annual"
          ]
        }
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relationship_status",
        "partner",
        "children"
      ],
      "properties": {
        "relationship_status": {
          "enum": [
            "single",
            "dating",
            "partnered",
            "married",
            "separated",
            "divorced",
            "widowed"
          ]
        },
        "partner": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "first_name",
                "age"
              ],
              "properties": {
                "first_name": {
                  "type": "string",
                  "minLength": 1
                },
                "age": {
                  "type": "integer",
                  "minimum": 16,
                  "maximum": 100
                }
              }
            }
          ]
        },
        "children": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "first_name",
              "age",
              "lives_in_household"
            ],
            "properties": {
              "first_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 50
              },
              "age": {
                "type": "integer",
                "minimum": 0,
                "maximum": 80
              },
              "lives_in_household": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "household": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "living_arrangement",
        "members"
      ],
      "properties": {
        "living_arrangement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "members": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "relationship",
              "first_name",
              "age"
            ],
            "properties": {
              "relationship": {
                "enum": [
                  "partner",
                  "child",
                  "parent",
                  "sibling",
                  "relative",
                  "roommate",
                  "other"
                ]
              },
              "first_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 50
              },
              "age": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        }
      }
    },
    "hobbies": {
      "type": "array",
      "minItems": 2,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 100
      }
    },
    "life_circumstances": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic",
          "detail",
          "timeframe"
        ],
        "properties": {
          "topic": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "detail": {
            "type": "string",
            "minLength": 8,
            "maxLength": 220
          },
          "timeframe": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
          }
        }
      }
    }
  }
}
